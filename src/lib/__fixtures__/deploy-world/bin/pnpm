#!/usr/bin/env bash
# A stand-in for pnpm: `vitest` passes, `build` writes a small but complete-looking .next into the
# current directory. Controls (files in $FAKE_WORLD/ctl): build-fail, tests-fail, next-behavior
# (copied into the build as FAKE_BEHAVIOR), build-leaks-path, build-sleep (seconds the build takes),
# commit-during-build (somebody else commits in $APP_DIR while the build runs).
set -u
world="${FAKE_WORLD:?}"
log() { printf '%s %s\n' "$(date +%s.%N)" "$*" >>"$world/events.log"; }
case "${1:-}" in
	vitest)
		log "pnpm vitest in $PWD"
		[[ ! -e "$world/ctl/tests-fail" ]]
		;;
	build)
		log "pnpm build in $PWD envfiles=$(ls -A | grep -E '^\.env' | sort | paste -sd, -)"
		if [[ -e "$world/ctl/build-fail" ]]; then
			echo "fake build: failing on purpose" >&2
			exit 1
		fi
		if [[ -f "$world/ctl/build-sleep" ]]; then
			sleep "$(cat "$world/ctl/build-sleep")"
		fi
		if [[ -e "$world/ctl/commit-during-build" ]]; then
			git -C "${APP_DIR:?}" -c user.name=Other -c user.email=other@example.com commit --allow-empty -q -m "somebody else's commit"
		fi
		id="build-$(date +%s%N)"
		mkdir -p .next/static/chunks .next/server .next/cache
		printf '%s' "$id" >.next/BUILD_ID
		head -c 700 /dev/zero | tr '\0' 'c' >".next/static/chunks/app-$id.css"
		head -c 500 /dev/zero | tr '\0' 'j' >".next/static/chunks/app-$id.js"
		printf '{"appDir":"%s","config":{"outputFileTracingRoot":"%s","turbopack":{"root":"%s"}}}\n' "$PWD" "$PWD" "$PWD" >.next/required-server-files.json
		printf 'module.exports = {"appDir":"%s"}\n' "$PWD" >.next/required-server-files.js
		if [[ -f "$world/ctl/next-behavior" ]]; then
			cp "$world/ctl/next-behavior" .next/FAKE_BEHAVIOR
		fi
		if [[ -e "$world/ctl/build-leaks-path" ]]; then
			printf '%s\n' "$PWD" >.next/server/leak.txt
		fi
		log "pnpm build made $id"
		;;
	*)
		echo "fake pnpm: unsupported: $*" >&2
		exit 2
		;;
esac
