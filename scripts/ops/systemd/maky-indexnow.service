# IndexNow: tell Bing and the other engines which maky.store URLs are new or changed.
#
# Run once a day by maky-indexnow.timer. Installed by a person on the web server, not by the deploy:
# see "The daily run" in docs/design/seo-indexing-bing.md (section 5).
#
# What one run does: reads the public sitemaps, sends the next 2 000 page and vehicle-page URLs it
# has not sent yet (then those that changed since they were sent) to api.indexnow.org, and writes what
# the engine accepted to the state file. It reads nothing from .env and touches neither PM2, nginx nor
# the build.
#
#   sudo install -m 644 scripts/ops/systemd/maky-indexnow.service scripts/ops/systemd/maky-indexnow.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now maky-indexnow.timer
#   systemctl list-timers maky-indexnow.timer                 # when it runs next
#   journalctl -u maky-indexnow.service --since "-2 days"     # what it sent, with the answers
#   sudo systemctl disable --now maky-indexnow.timer          # stop it; the state file keeps the progress
[Unit]
Description=IndexNow, send new and changed maky.store URLs to Bing
Documentation=file:///opt/storefront/docs/design/seo-indexing-bing.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/storefront

# Not while a deploy runs. deploy-production.sh holds this lock for its whole length; flock exits 1
# when it is held, and systemd treats an ExecCondition exit of 1 to 254 as "skip", not "failed".
# Tomorrow's run picks up what today's did not send.
ExecCondition=/usr/bin/flock -n /run/lock/maky-storefront-deploy.lock -c true

# The state file lives in /var/lib/maky-indexnow, which systemd creates for User=ubuntu.
#
# Pages and vehicle pages only, 2 000 a day, pages first. The daily run used to send 10 000 URLs of
# every kind, market by market, products first (1 to 3 November: 30 000 URLs, 28 495 of them
# products). Bing Webmaster Tools then reported "IndexNow is in batch mode" (not recommended), and
# the nginx log showed no effect: of the URLs sent on 1 November, 0.9 % were fetched by Bingbot
# within 24 hours, against 0.7 % of the ones not sent. The products (238 577 of the 256 178 sitemap
# URLs) stay with the sitemap, which carries their `lastmod`; the vehicle pages and the pages are the
# ones with their own texts, so they are the ones worth a message. About 16 000 of them are still
# unsent: eight days at 2 000, after which a run has nothing to send until a page or a vehicle
# appears. Raise --max or add `products` back to the list only if the measurement in
# docs/design/seo-indexing-bing.md, section 9, shows the URLs told on a day being fetched more often
# than the ones not yet told.
# A 200 is recorded; a 202 or anything else stops the run and fails the unit.
ExecStart=/usr/bin/env node scripts/ops/indexnow.mjs --kinds pages,vehicles --max 2000 --state /var/lib/maky-indexnow/state.json --fire
StateDirectory=maky-indexnow

# A small job that must never compete with the shop: low priority, a memory ceiling, no swap.
Nice=15
MemoryMax=768M
MemorySwapMax=0
TimeoutStartSec=30min
NoNewPrivileges=yes
