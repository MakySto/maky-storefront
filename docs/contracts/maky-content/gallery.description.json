{"blocks":[{"data":{"text":"Toto je ukážka všetkých blokov, z ktorých sa skladá popis produktu. Slúži na kontrolu vzhľadu a nepatrí k žiadnemu produktu."},"type":"paragraph"},{"data":{"level":3,"text":"Tip"},"type":"header"},{"data":{"text":"Ukážka tipu: krátka rada, ktorá zákazníkovi uľahčí výber alebo používanie produktu."},"id":"maky:callout:tip","type":"paragraph"},{"data":{"text":"Ukážka poznámky: doplňujúca informácia, ktorá nie je ani tipom, ani varovaním."},"id":"maky:callout:info","type":"paragraph"},{"data":{"level":3,"text":"Upozornenie"},"type":"header"},{"data":{"items":["Ukážka varovania: dôležitú bezpečnostnú informáciu stránka nikdy nevynechá.","Viac varovaní sa píše ako položky jedného bloku a každé zostane čitateľné samostatne."],"style":"unordered"},"id":"maky:callout:warn","type":"list"},{"data":{"level":2,"text":"Prečo si ho vybrať"},"type":"header"},{"data":{"items":["<strong>Prvá výhoda</strong> Krátky popis výhody, ktorý sa zmestí na jeden až dva riadky.","<strong>Druhá výhoda</strong> Výhody sa radia pod seba a každá má vlastnú odrážku.","<strong>Tretia výhoda</strong> Dlhší text výhody sa zalomí a odrážka ostane pri prvom riadku.","<strong>Štvrtá výhoda</strong>"],"style":"unordered"},"id":"maky:benefits","type":"list"},{"data":{"level":2,"text":"Čo nájdete v balení"},"type":"header"},{"data":{"items":["<strong>Hlavný produkt</strong> 1 ks","<strong>Napájací kábel</strong>","<strong>Adaptér</strong>","<strong>Návod na použitie</strong> v slovenčine","<strong>Úložná taška</strong>","<strong>Montážna sada</strong>"],"style":"unordered"},"id":"maky:inbox","type":"list"},{"data":{"level":2,"text":"Kľúčové vlastnosti"},"type":"header"},{"data":{"items":[{"content":"<strong>Prvá vlastnosť</strong> Ukážka vlastnosti s ikonou batérie.","items":[{"content":"Doplnkový popisok","items":[]}],"meta":{"icon":"battery"}},{"content":"<strong>Druhá vlastnosť</strong> Ukážka s ikonou stojana.","items":[],"meta":{"icon":"stand"}},{"content":"<strong>Tretia vlastnosť</strong> Ukážka s ikonou telefónu.","items":[{"content":"Popisok môže byť dlhší ako text vlastnosti, no ostane pod ním.","items":[]}],"meta":{"icon":"smartphone"}},{"content":"<strong>Štvrtá vlastnosť</strong> Ukážka s ikonou žiarovky.","items":[],"meta":{"icon":"lightbulb"}},{"content":"<strong>Piata vlastnosť</strong> Ukážka s ikonou snehovej vločky.","items":[],"meta":{"icon":"snowflake"}},{"content":"<strong>Šiesta vlastnosť</strong> Ukážka s ikonou zástrčky.","items":[],"meta":{"icon":"plug"}},{"content":"<strong>Siedma vlastnosť</strong> Ukážka s ikonou štítu.","items":[],"meta":{"icon":"shield"}},{"content":"<strong>Vlastnosť bez ikony</strong> Bez názvu ikony sa nakreslí všeobecná značka.","items":[]}],"style":"unordered"},"id":"maky:features","type":"list"},{"data":{"level":2,"text":"Ako začať"},"type":"header"},{"data":{"items":["<strong>Rozbaľte</strong> Vyberte produkt z obalu a skontrolujte obsah balenia.","<strong>Pripojte</strong> Zapojte ho do zdroja napájania.","<strong>Nastavte</strong> Zvoľte požadovaný režim.","<strong>Používajte</strong>"],"style":"ordered"},"id":"maky:steps","type":"list"},{"data":{"level":2,"text":"Časté otázky"},"type":"header"},{"data":{"items":[{"content":"Prvá otázka?","items":[{"content":"Odpoveď sa zobrazí po otvorení otázky a je to obyčajný text.","items":[]}]},{"content":"Druhá otázka, ktorá je dlhšia a na úzkom displeji sa zalomí na viac riadkov?","items":[{"content":"Aj dlhšia odpoveď ostane čitateľná, pretože ju stránka zalomí do šírky bloku.","items":[]}]},{"content":"Tretia otázka?","items":[{"content":"Krátka odpoveď.","items":[]}]}],"style":"unordered"},"id":"maky:faq","type":"list"},{"data":{"level":2,"text":"Video"},"type":"header"},{"data":{"caption":"Ukážka videa: PRO-USER CoolZ – kompresorové autochladničky s powerbankou","embed":"https://www.youtube.com/embed/D5lm_R-m3BA","service":"youtube","source":"https://www.youtube.com/watch?v=D5lm_R-m3BA"},"id":"maky:video","type":"embed"},{"data":{"level":2,"text":"Technické parametre"},"type":"header"},{"data":{"content":[["Prvá skupina",""],["Prvý parameter","10 l"],["Druhý parameter","−20 °C až +20 °C"],["Tretí parameter","Áno"],["Druhá skupina",""],["Štvrtý parameter","12/24 V DC"],["Dlhý parameter","Dlhá hodnota, ktorá sa na úzkom displeji zalomí pod názov parametra"]],"withHeadings":false},"id":"maky:specs","type":"table"},{"data":{"level":2,"text":"Dokumenty na stiahnutie"},"type":"header"},{"data":{"items":["<a href=\"/dokumenty/ukazka-navod.pdf\">Návod na použitie</a> PDF · SK","<a href=\"/dokumenty/ukazka-list.pdf\">Technický list</a> PDF · EN","<a href=\"/dokumenty/ukazka-zhoda.pdf\">Vyhlásenie o zhode</a>"],"style":"unordered"},"id":"maky:documents","type":"list"}],"version":"maky-content/1:autochladnicka"}
