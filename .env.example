# Saleor API URL (required) - keep the trailing slash
NEXT_PUBLIC_SALEOR_API_URL=https://your-instance.saleor.cloud/graphql/

# Storefront URL - set on production for correct canonical URLs and OG images
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Channel slug (required) - your Saleor channel identifier
# The root "/" redirects to this channel (e.g., "/default-channel")
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# App token (optional) - enables multi-channel builds by discovering additional channels
# SALEOR_APP_TOKEN=

# --- Payments (checkout v2 payment registry, Track B.4.4/B.8) ---
# Stripe Elements checkout — required in production builds; dev auto-enables.
# NEXT_PUBLIC_ENABLE_STRIPE_PAYMENTS=true
# Server-side mirror for the transactionInitialize guard.
# ENABLE_STRIPE_PAYMENTS=true
# Stripe wallet buttons (Apple Pay / Google Pay / Link); default on when Stripe is enabled.
# NEXT_PUBLIC_ENABLE_STRIPE_EXPRESS_CHECKOUT=false
# Saleor Dummy Payment app — test checkouts only, never enable in production.
# ALLOW_DUMMY_PAYMENT=true
# NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true

# --- Payload CMS (editorial content) ---
# None of these may ever be NEXT_PUBLIC_: the Cloudflare Access service token is
# what gets the server past the Access gate in front of the CMS, and the browser
# must never talk to cms.maky.store directly.
# PAYLOAD_CMS_URL=https://cms.maky.store
# Cloudflare Access service token — sent as CF-Access-Client-Id / -Secret.
# PAYLOAD_CF_ACCESS_CLIENT_ID=
# PAYLOAD_CF_ACCESS_CLIENT_SECRET=
# Bearer secret the CMS presents to /api/revalidate/payload. Distinct from
# REVALIDATE_SECRET, which belongs to the Saleor webhook — do not reuse either one.
# PAYLOAD_REVALIDATE_SECRET=
# Optional; defaults to 5000.
# PAYLOAD_CMS_FETCH_TIMEOUT_MS=5000

# --- Market indexability ---
# Which markets Google may index. Everything else in CHANNEL_MAP stays reachable
# at its URL but is served with `X-Robots-Tag: noindex, nofollow`, kept out of the
# sitemap and out of every hreflang cluster, and is never chosen for a visitor by
# the root geo/language redirect.
#
# Server-side only, deliberately NOT NEXT_PUBLIC_: those are inlined at build time,
# and the point of this variable is that a market can change state with a restart.
# Unknown names are dropped and reported at boot; a value that resolves to nothing
# falls back to the default rather than deindexing the site.
#
# Defaults to `sk` when unset. The deploy script prints the requested set in
# preflight and confirms the running set after the gate.
# MAKY_LIVE_MARKETS=sk

# --- Payload forms (withdrawal notice, § 20a) ---
# Server-only, all of them. None may ever gain a NEXT_PUBLIC_ prefix: the CF Access
# pair opens the network boundary and the HMAC secret authorises writing a legally
# significant record, so either one in the browser would let anyone forge a
# withdrawal notice.
#
# The CF Access pair is the SAME one the CMS reader uses (one Cloudflare application
# in front of one host) and is documented with the CMS settings.
#
# Application-level authorisation for POST /api/forms/withdrawal. Until this is set,
# submissions fail closed and the UI says the notice was NOT received.
# MAKY_FORMS_HMAC_SECRET=
# Optional; defaults to 8000 ms.
# MAKY_FORMS_TIMEOUT_MS=8000
#
# Sequencing interlock for the online withdrawal function. The route always serves its
# legal content; this only decides whether the FORM is offered. Anything other than the
# exact string "true" keeps it off in production builds. Set it to "true" only after the
# matching Payload Returns V2 experience and SK/sk bundle pass backend readiness.
# WITHDRAWAL_BACKEND_LIVE=true

# --- Route existence gate (real HTTP 404 for a resource that is not there) ---
# Ships INERT. With these unset a missing product or category renders a not-found
# body under HTTP 200, which Google reads as a thin duplicate rather than a
# removal. See src/lib/route-existence.ts and
# docs/design/seo-hard-404-analysis-20260806.md.
#
# All three are required together, and an empty market or family list means NONE,
# never "all" — arming is an explicit act, per market and per family, and
# disarming needs a restart rather than a deploy.
#
# Only `absent` — HTTP 200 from Saleor, valid JSON, no `errors`, the resource
# field explicitly null — becomes a 404. A timeout, a 5xx, malformed JSON, an open
# breaker or a saturated concurrency limit all answer `unknown` and the request
# proceeds exactly as it does with the gate off.
#
# Every response the gate looks at carries `x-maky-gate: <family>:<verdict>`, so a
# canary can be read straight off a live request without turning on debug logging.
#
# The global kill switch. Anything other than the exact string `on` is off.
# ROUTE_EXISTENCE_GATE=on
# Friendly market slugs from CHANNEL_MAP. Unknown names are ignored.
# ROUTE_EXISTENCE_MARKETS=sk
# One or more of: product, collection, category, saleor-page.
# `product` and `category` are the two families the Slovak catalogue routes to —
# /sk/{slug} and /sk/categories/{slug}. Note that `category(slug:)` takes no
# channel in Saleor, so this answers "does the slug exist at all"; a category that
# exists globally but holds nothing in this market is an indexability decision and
# is handled by the page's metadata, not by a 404.
# ROUTE_EXISTENCE_FAMILIES=product,category
