# Saleor API URL (required) - keep the trailing slash
NEXT_PUBLIC_SALEOR_API_URL=https://your-instance.saleor.cloud/graphql/

# Storefront URL - set on production for correct canonical URLs and OG images
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Channel slug (required) - your Saleor channel identifier
# The root "/" redirects to this channel (e.g., "/default-channel")
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# App token (optional) - enables multi-channel builds by discovering additional channels
# SALEOR_APP_TOKEN=

# --- Payments (checkout v2 payment registry, Track B.4.4/B.8) ---
# Stripe Elements checkout — required in production builds; dev auto-enables.
# NEXT_PUBLIC_ENABLE_STRIPE_PAYMENTS=true
# Server-side mirror for the transactionInitialize guard.
# ENABLE_STRIPE_PAYMENTS=true
# Stripe wallet buttons (Apple Pay / Google Pay / Link); default on when Stripe is enabled.
# NEXT_PUBLIC_ENABLE_STRIPE_EXPRESS_CHECKOUT=false
# Saleor Dummy Payment app — test checkouts only, never enable in production.
# ALLOW_DUMMY_PAYMENT=true
# NEXT_PUBLIC_ALLOW_DUMMY_PAYMENT=true

# --- Payload CMS (editorial content) ---
# None of these may ever be NEXT_PUBLIC_: the Cloudflare Access service token is
# what gets the server past the Access gate in front of the CMS, and the browser
# must never talk to cms.maky.store directly.
# PAYLOAD_CMS_URL=https://cms.maky.store
# Cloudflare Access service token — sent as CF-Access-Client-Id / -Secret.
# PAYLOAD_CF_ACCESS_CLIENT_ID=
# PAYLOAD_CF_ACCESS_CLIENT_SECRET=
# Bearer secret the CMS presents to /api/revalidate/payload. Distinct from
# REVALIDATE_SECRET, which belongs to the Saleor webhook — do not reuse either one.
# PAYLOAD_REVALIDATE_SECRET=
# Optional; defaults to 5000.
# PAYLOAD_CMS_FETCH_TIMEOUT_MS=5000

# --- Market indexability ---
# Which markets Google may index. Everything else in CHANNEL_MAP stays reachable
# at its URL but is served with `X-Robots-Tag: noindex, nofollow`, kept out of the
# sitemap and out of every hreflang cluster, and is never chosen for a visitor by
# the root geo/language redirect.
#
# Server-side only, deliberately NOT NEXT_PUBLIC_: those are inlined at build time,
# and the point of this variable is that a market can change state with a restart.
# Unknown names are dropped and reported at boot; a value that resolves to nothing
# falls back to the default rather than deindexing the site.
#
# Defaults to `sk` when unset. The deploy script prints the requested set in
# preflight and confirms the running set after the gate.
# MAKY_LIVE_MARKETS=sk
